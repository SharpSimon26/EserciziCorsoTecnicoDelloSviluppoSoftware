@page "/home-old"
@* @attribute [StreamRendering] *@
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@if (loading)
{
    <h1>Attendi....</h1>
}
else
{
    <ul>
        @for (int i = 0; i < items.Count; i++)
        {
            <li>@items[i]</li>
        }
    </ul>
}


@code {
    bool loading = false;
    List<string> items = [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        for (int i = 0; i < 100; i++)
        {
            items.Add($"pippo {i + 1}");
            await Task.Delay(300);
            //StateHasChanged();
        }

        loading = false;
    }
}