<div class="text-center">
    <h1 class="display-4">Photos: @Model.Photos.Count()</h1>
</div>

<ul class="list-group">
@foreach (var item in Model.Photos)
{
    <li class="list-group-item">@item.Title <a asp-page="Like" asp-route-id="@item.Id"><i class="bi bi-hand-thumbs-up"></i></a> @item.NumLikes</li>
}
</ul>
