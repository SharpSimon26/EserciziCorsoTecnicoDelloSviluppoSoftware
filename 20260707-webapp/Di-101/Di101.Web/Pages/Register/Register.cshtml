@page
@model Di101.Web.Pages.Register.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Username" class="form-label">Username</label>
        <input asp-for="Input.Username"  type="text" placeholder="username" class="form-control">
        <span asp-validation-for="Input.Username" class="form-text text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"">Email</label>
        <input asp-for="Input.Email" type="text" placeholder="email" class="form-control">
        <span asp-validation-for="Input.Email" class="form-text text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <input asp-for="Input.Password" type="password" placeholder="password" class="form-control">
        <span asp-validation-for="Input.Password" class="form-text text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Conferma password</label>
        <input asp-for="Input.ConfirmPassword" type="password" placeholder="conferma password" class="form-control">
        <span asp-validation-for="Input.ConfirmPassword" class="form-text text-danger"></span>
    </div>

    <input type="submit" value="Registra" class="btn btn-primary">
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
