<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Text</th>
            <th>Done</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in @Model.Todos)
    {
        <tr>
            <td>@item.Id</td>
            <td><a asp-page="/Dettaglio" asp-route-id="@item.Id">@item.Text</a></td>
            <td>@(item.Done ? "OK" : "NO")</td>
        </tr>
    }
    </tbody>
</table>