@page
@model WebAppTodo.Web.Pages.Todo1Model
@{
    ViewData["Title"] = "Todo";
}

<div class="container">
    <div class="row py-3">
        <div class="col d-flex justify-content-between">
            <h1 class="mb-0">Todo</h1>
            <button class="btn btn-primary">Nuovo</button>
        </div>
    </div>    
    @foreach (var todo in Model.Todos)
    {
        <div class="row py-3">
            <div class="col">@todo.Id</div>
            <div class="col-5 text-start">@todo.Description</div>
            <div class="col text-center">
                @if (todo.Done) {
                    <i class="fs-4 bi bi-check-square-fill text-success"></i>
                } else {
                    <i class="fs-4 bi bi-x-square-fill text-danger"></i>
                }
            </div>
            <div class="col text-end">
                <button class="btn btn-secondary" data-id="@todo.Id">Modifica</button>
            </div>
        </div>
    }
</div>
